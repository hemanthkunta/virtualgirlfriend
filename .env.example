# Environment variables for Virtual Girlfriend AI
# Copy this to .env and fill in with your actual values

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# TTS Provider (pyttsx3 or elevenlabs)
TTS_PROVIDER=pyttsx3
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here

# Database
# Local fallback
DATABASE_URL=sqlite:///./virtualgirlfriend.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://virtualgirlfriend:change_me@localhost:5432/virtualgirlfriend

# Audio Settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# Video Settings
VIDEO_FPS=30
VIDEO_RESOLUTION=1280x720

# API Settings
MAX_UPLOAD_SIZE_MB=50
API_TIMEOUT=60

# Logging
LOG_LEVEL=INFO
